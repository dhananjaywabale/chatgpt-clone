# Copy this file to .env and fill in your own values.
# Never commit your real .env file to version control.

# Claude key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Google Programmable Search credentials. Without these, the agent
# remains usable and will explain when live search is unavailable.
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Port the Express server listens on
PORT=5000

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-20250514

# Agent and outbound request safeguards
AGENT_MAX_STEPS=4
TOOL_TIMEOUT_MS=8000
MAX_MESSAGE_LENGTH=12000
SHORT_TERM_HISTORY=15
LONG_TERM_MEMORY_ENABLED=true
MAX_MEMORY_RESULTS=5
